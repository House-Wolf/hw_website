# Command dashboard: setup only; never enable delivery before operator preflight.
COMMAND_DASHBOARD_ENABLED="false"
COMMAND_DISCORD_DELIVERY_ENABLED="false"
# Enable only after the manual crews/readiness migration and compatible web rollout.
COMMAND_STAFFING_ENABLED="false"
# Enable after the operations management/staffing migration and compatible worker rollout.
COMMAND_ADVANCED_OPERATIONS_ENABLED="false"
