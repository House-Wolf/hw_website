  displayOrder   Int                          @default(0) @map("display_order")
  awardType      String                       @default("Medal") @map("award_type")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  awards         PackTrackerMedalAward[]
  nominations    PackTrackerMedalNomination[]

  @@map("packtracker_medal_definitions")
}

model PackTrackerMedalAward {
  id                String                     @id @default(uuid()) @db.Uuid
  medalDefinitionId String                     @map("medal_definition_id") @db.Uuid
  profileId         String?                    @map("profile_id") @db.Uuid
  recipientName     String                     @map("recipient_name")
  awardedAt         DateTime?                  @map("awarded_at") @db.Timestamptz(6)
  importedAt        DateTime                   @default(now()) @map("imported_at") @db.Timestamptz(6)
  sourceSystem      String                     @default("wolf_raid") @map("source_system")
  citation          String?
  awardedBy         String?                    @map("awarded_by")
  awardType         String                     @default("Medal") @map("award_type")
  medalDefinition   PackTrackerMedalDefinition @relation(fields: [medalDefinitionId], references: [id], onDelete: Cascade)
  profile           PackTrackerProfile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([medalDefinitionId, recipientName])
  @@index([profileId])
  @@map("packtracker_medal_awards")
}

model PackTrackerMedalNomination {
  id                  String                     @id @default(uuid()) @db.Uuid
  medalDefinitionId   String                     @map("medal_definition_id") @db.Uuid
  nomineeProfileId    String?                    @map("nominee_profile_id") @db.Uuid
  nomineeName         String                     @map("nominee_name")
  nominatorProfileId  String?                    @map("nominator_profile_id") @db.Uuid
  nominatorName       String                     @map("nominator_name")
  citation            String
  status              Int                        @default(0)
  submittedAt         DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt          DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  reviewedByProfileId String?                    @map("reviewed_by_profile_id") @db.Uuid
  reviewedByName      String?                    @map("reviewed_by_name")
  reviewNotes         String?                    @map("review_notes")
  medalDefinition     PackTrackerMedalDefinition @relation(fields: [medalDefinitionId], references: [id], onDelete: Restrict)
  nomineeProfile      PackTrackerProfile?        @relation("PackTrackerMedalNominee", fields: [nomineeProfileId], references: [id], onDelete: SetNull)
  nominatorProfile    PackTrackerProfile?        @relation("PackTrackerMedalNominator", fields: [nominatorProfileId], references: [id], onDelete: SetNull)
  reviewedByProfile   PackTrackerProfile?        @relation("PackTrackerMedalReviewer", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@map("packtracker_medal_nominations")
}

model PackTrackerAdminRole {
  id                    String                                 @id @default(uuid()) @db.Uuid
  name                  String                                 @unique
  tier                  Int                                    @default(0)
  isSystemRole          Boolean                                @default(true) @map("is_system_role")
  createdAt             DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  permissionAssignments PackTrackerAdminPermissionAssignment[]
  memberAssignments     PackTrackerMemberRoleAssignment[]

  @@map("packtracker_admin_roles")
}

model PackTrackerAdminPermissionAssignment {
  id            String               @id @default(uuid()) @db.Uuid
  adminRoleId   String               @map("admin_role_id") @db.Uuid
  permissionKey String               @map("permission_key")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  adminRole     PackTrackerAdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, permissionKey])
  @@map("packtracker_admin_permission_assignments")
}

model PackTrackerMemberRoleAssignment {
  id                  String               @id @default(uuid()) @db.Uuid
  profileId           String               @map("profile_id") @db.Uuid
  adminRoleId         String               @map("admin_role_id") @db.Uuid
  assignedByProfileId String               @map("assigned_by_profile_id") @db.Uuid
  assignedAt          DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt           DateTime?            @map("revoked_at") @db.Timestamptz(6)
  notes               String?
  profile             PackTrackerProfile   @relation("PackTrackerMemberRoleProfile", fields: [profileId], references: [id], onDelete: Restrict)
  adminRole           PackTrackerAdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)
  assignedByProfile   PackTrackerProfile   @relation("PackTrackerMemberRoleAssignedBy", fields: [assignedByProfileId], references: [id], onDelete: Restrict)

  @@index([profileId])
  @@index([adminRoleId])
  @@index([assignedByProfileId])
  @@map("packtracker_member_role_assignments")
}

model PackTrackerAdminAuditLog {
  id             String              @id @default(uuid()) @db.Uuid
  actorProfileId String?             @map("actor_profile_id") @db.Uuid
  action         String
  targetType     String              @map("target_type")
  targetId       String              @map("target_id")
  summary        String
  beforeJson     String?             @map("before_json")
  afterJson      String?             @map("after_json")
  severity       String              @default("Info")
  correlationId  String?             @map("correlation_id")
  exception      String?
  machineName    String?             @map("machine_name")
  environment    String?
  occurredAt     DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorProfile   PackTrackerProfile? @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorProfileId, occurredAt])
  @@index([targetType, targetId])
  @@map("packtracker_admin_audit_logs")
}

model PackTrackerDiscordIntegrationSetting {
  id                          String              @id @default(uuid()) @db.Uuid
  operationsEnabled           Boolean             @default(false) @map("operations_enabled")
  medalAnnouncementsEnabled   Boolean             @default(false) @map("medal_announcements_enabled")
  recruitingPostsEnabled      Boolean             @default(false) @map("recruiting_posts_enabled")
  operationsChannelId         String?             @map("operations_channel_id")
  medalAnnouncementsChannelId String?             @map("medal_announcements_channel_id")
  recruitingPostsChannelId    String?             @map("recruiting_posts_channel_id")
  updatedByProfileId          String?             @map("updated_by_profile_id") @db.Uuid
  updatedAt                   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByProfile            PackTrackerProfile? @relation(fields: [updatedByProfileId], references: [id], onDelete: Restrict)

  @@map("packtracker_discord_integration_settings")
}

model PackTrackerSyncMetadata {
  id               String    @id @default(uuid()) @db.Uuid
  taskName         String    @unique @map("task_name")
  lastStartedAt    DateTime? @map("last_started_at") @db.Timestamptz(6)
  lastCompletedAt  DateTime? @map("last_completed_at") @db.Timestamptz(6)
  isSuccess        Boolean   @default(false) @map("is_success")
  lastErrorMessage String?   @map("last_error_message")
  itemsProcessed   Int       @default(0) @map("items_processed")

  @@map("packtracker_sync_metadata")
}

model PackTrackerDistributedLock {
  lockKey   String   @id @map("lock_key")
  lockedBy  String   @map("locked_by")
  lockedAt  DateTime @default(now()) @map("locked_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("packtracker_distributed_locks")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model SiteSetting {
  key   String @id
  value Json

  @@map("site_settings")
}

model notifications {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String                 @db.Uuid
  type       notification_type_enum
  title      String?
  message    String?
  link_url   String?
  is_read    Boolean                @default(false)
  read_at    DateTime?              @db.Timestamptz(6)
  created_at DateTime               @default(now()) @db.Timestamptz(6)
  users      User                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SocialLink {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  platform        String
  channelName     String    @map("channel_name")
  channelUrl      String    @map("channel_url")
  description     String?
  status          String    @default("PENDING")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy      String?   @map("approved_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  approver        User?     @relation("ApprovedSocialLinks", fields: [approvedBy], references: [id])
  rejecter        User?     @relation("RejectedSocialLinks", fields: [rejectedBy], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

model featured_videos {
  id         Int      @id @default(autoincrement())
  youtube_id String
  title      String
  thumbnail  String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  updated_by String?  @db.Uuid
}

enum notification_type_enum {
  PROFILE_APPROVED
  PROFILE_REJECTED
  LISTING_UPDATE
  LISTING_SOLD
  SUSPENSION
  SYSTEM
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  EXPIRED
  DELETED
}

enum ListingVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum ProfileAction {
  SUBMITTED
  APPROVED
  REJECTED
  REVERTED
}
