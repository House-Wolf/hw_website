generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  commandOperations         CommandOperation[]
  commandSignups            CommandSignup[]
  commandDeliveries         CommandDelivery[]
  id                        String                            @id @default(uuid()) @db.Uuid
  discordId                 String                            @unique @map("discord_id")
  discordUsername           String                            @map("discord_username")
  discordDisplayName        String?                           @map("discord_display_name")
  avatarUrl                 String?                           @map("avatar_url")
  isActive                  Boolean                           @default(true) @map("is_active")
  lastLoginAt               DateTime?                         @map("last_login_at") @db.Timestamptz(6)
  createdAt                 DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  email                     String?                           @unique
  emailVerified             DateTime?                         @map("email_verified")
  image                     String?
  name                      String?
  accounts                  Account[]
  auditLogs                 AuditLog[]
  listingAudits             MarketplaceListingAuditLog[]
  marketplaceListings       MarketplaceListings[]
  suspendedMarketplaceUsers MarketplaceUserStatus[]           @relation("SuspendedBy")
  marketplaceStatus         MarketplaceUserStatus?
  profileApprovalHistory    MercenaryProfileApprovalHistory[]
  approvedProfiles          MercenaryProfile[]                @relation("ApprovedBy")
  rejectedProfiles          MercenaryProfile[]                @relation("RejectedBy")
  mercenaryProfiles         MercenaryProfile[]                @relation("UserProfiles")
  notifications             notifications[]
  sessions                  Session[]
  approvedSocialLinks       SocialLink[]                      @relation("ApprovedSocialLinks")
  rejectedSocialLinks       SocialLink[]                      @relation("RejectedSocialLinks")
  socialLinks               SocialLink[]
  roles                     UserRole[]
  themePreference           String?                           @default("night") @map("theme_preference")
  packTrackerProfile        PackTrackerProfile?
  onboardingProfile         OnboardingProfile?

  @@map("users")
}

model CommandOperation {
  id             String @id @default(uuid()) @db.Uuid
  guildId        String
  creatorId      String @db.Uuid
  creator        User @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  managerIds     String[] @default([])
  input          Json
  state          String @default("DRAFT")
  revision       Int @default(1)
  requestKey     String
  nativeEventId  String? @unique
  nativeSnapshot Json?
  remoteSnapshot Json?
  syncState      String @default("CLEAN")
  announcementId String?
  announcementChannelId String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  deliveries     CommandDelivery[]
  signups        CommandSignup[]
  @@unique([guildId, creatorId, requestKey])
  @@index([guildId, state, updatedAt])
  @@map("command_operations")
}

model CommandDelivery {
  id          String @id @default(uuid()) @db.Uuid
  operationId String @db.Uuid
  operation   CommandOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  revision    Int
  kind        String
  actorId     String @db.Uuid
  actor       User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  status      String @default("PENDING")
  attempts    Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  leaseUntil  DateTime? @db.Timestamptz(6)
  leaseToken  String?
  sendingAt   DateTime? @db.Timestamptz(6)
  errorCode   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  @@unique([operationId, revision, kind])
  @@index([status, availableAt, leaseUntil])
  @@map("command_deliveries")
}

model CommandSignup {
  operationId String @db.Uuid
  operation   CommandOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  userId      String @db.Uuid
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      String
  preferences String @default("")
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  @@id([operationId, userId])
  @@map("command_signups")
}

model OnboardingProfile {
  userId          String    @id @map("user_id") @db.Uuid
  interests       String[]
  otherGame       String?   @map("other_game")
  rulesVersion    String    @map("rules_version")
  rulesAcceptedAt DateTime  @map("rules_accepted_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  welcomeMessageId String?  @map("welcome_message_id")
  welcomeClaimedAt DateTime? @map("welcome_claimed_at") @db.Timestamptz(6)
  welcomeLastError String?  @map("welcome_last_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
  @@index([completedAt, welcomeMessageId])
}

model DiscordActivityState {
  guildId           String   @id @map("guild_id")
  trackingStartedAt DateTime @default(now()) @map("tracking_started_at") @db.Timestamptz(6)
  periodStartedAt   DateTime @default(now()) @map("period_started_at") @db.Timestamptz(6)
  nextReportAt      DateTime @map("next_report_at") @db.Timestamptz(6)

  @@map("discord_activity_states")
}

model DiscordMemberActivity {
  guildId      String   @map("guild_id")
  discordId    String   @map("discord_id")
  periodStartedAt DateTime @map("period_started_at") @db.Timestamptz(6)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(6)
  source       String

  @@id([guildId, discordId, periodStartedAt])
  @@map("discord_member_activity")
}

model DiscordActivityDelivery {
  id              String    @id @default(uuid()) @db.Uuid
  guildId         String    @map("guild_id")
  recipientId     String    @map("recipient_id")
  periodStartedAt DateTime  @map("period_started_at") @db.Timestamptz(6)
  periodEndedAt   DateTime  @map("period_ended_at") @db.Timestamptz(6)
  report          Json
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6)
  messageId       String?   @map("message_id")
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processingUntil DateTime? @map("processing_until") @db.Timestamptz(6)
  processingToken String?   @map("processing_token")
  lastError       String?   @map("last_error")

  @@unique([guildId, recipientId, periodEndedAt])
  @@index([guildId, sentAt, nextAttemptAt])
  @@map("discord_activity_deliveries")
}

model PersonnelMember {
  id                    String   @id @default(uuid()) @db.Uuid
  guildId               String   @map("guild_id")
  discordId             String   @map("discord_id")
  rsiHandle             String?  @map("rsi_handle")
  applicationAcceptedAt DateTime? @map("application_accepted_at") @db.Timestamptz(6)
  membershipConfirmedAt DateTime? @map("membership_confirmed_at") @db.Timestamptz(6)
  membershipVerifiedBy  String?  @map("membership_verified_by")
  membershipEvidence    String?  @map("membership_evidence")
  rsiCheckedAt          DateTime? @map("rsi_checked_at") @db.Timestamptz(6)
  currentRankRoleId     String?  @map("current_rank_role_id")
  rankSince             DateTime? @map("rank_since") @db.Timestamptz(6)
  rankSource            String?  @map("rank_source")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  promotions            PromotionRequest[]

  @@unique([guildId, discordId])
  @@unique([guildId, rsiHandle])
  @@map("personnel_members")
}

model PromotionRequest {
  id                    String @id @default(uuid()) @db.Uuid
  memberId              String @map("member_id") @db.Uuid
  sourceRankRoleId      String @map("source_rank_role_id")
  targetRankRoleId      String @map("target_rank_role_id")
  rankSince             DateTime @map("rank_since") @db.Timestamptz(6)
  eligibleAt            DateTime @map("eligible_at") @db.Timestamptz(6)
  approvalsRequired     Int @map("approvals_required")
  status                String @default("REVIEW")
  thresholdAt           DateTime? @map("threshold_at") @db.Timestamptz(6)
  executeAfter          DateTime? @map("execute_after") @db.Timestamptz(6)
  vetoedBy              String? @map("vetoed_by")
  nextReviewReminderAt   DateTime? @map("next_review_reminder_at") @db.Timestamptz(6)
  lastReviewReminderAt   DateTime? @map("last_review_reminder_at") @db.Timestamptz(6)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  officerMessageId      String? @map("officer_message_id")
  announcementMessageId String? @map("announcement_message_id")
  processingToken       String? @map("processing_token")
  processingUntil       DateTime? @map("processing_until") @db.Timestamptz(6)
  lastError             String? @map("last_error")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  member                PersonnelMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  votes                 PromotionVote[]

  @@unique([memberId, sourceRankRoleId, rankSince])
  @@index([status, executeAfter])
  @@index([status, nextReviewReminderAt])
  @@map("promotion_requests")
}

model PromotionVote {
  requestId       String @map("request_id") @db.Uuid
  voterDiscordId  String @map("voter_discord_id")
  decision        String
  isVeto          Boolean @default(false) @map("is_veto")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  request         PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, voterDiscordId])
  @@map("promotion_votes")
}

model PersonnelCommand {
  id                String @id @default(uuid()) @db.Uuid
  guildId           String @map("guild_id")
  key               String
  name              String
  commandRoleId     String @map("command_role_id")
  allowedRoleIds    String[] @default([]) @map("allowed_role_ids")
  captainDiscordIds String[] @default([]) @map("captain_discord_ids")
  updatedBy         String @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([guildId, key])
  @@map("personnel_commands")
}

model PersonnelRoleAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  guildId         String    @map("guild_id")
  discordId       String    @map("discord_id")
  actorId         String    @map("actor_id")
  commandKey      String    @map("command_key")
  roleId          String    @map("role_id")
  action          String
  status          String    @default("PENDING")
  processingToken String?   @map("processing_token")
  processingUntil DateTime? @map("processing_until") @db.Timestamptz(6)
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([guildId, status, nextAttemptAt])
  @@index([guildId, discordId, status])
  @@map("personnel_role_assignments")
}

model PersonnelAudit {
  id              String @id @default(uuid()) @db.Uuid
  guildId         String @map("guild_id")
  actorDiscordId  String? @map("actor_discord_id")
  memberDiscordId String @map("member_discord_id")
  requestId       String? @map("request_id") @db.Uuid
  action          String
  details         Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([guildId, memberDiscordId, createdAt])
  @@map("personnel_audits")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model DiscordRole {
  id                      String                   @id @map("id")
  name                    String
  color                   Int?
  position                Int?
  isManaged               Boolean                  @default(false) @map("is_managed")
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  divisionAllowedRoles    DivisionAllowedRole[]
  permissions             RolePermission[]
  subdivisionAllowedRoles SubdivisionAllowedRole[]
  users                   UserRole[]

  @@map("discord_roles")
}

model UserRole {
  userId        String      @map("user_id") @db.Uuid
  discordRoleId String      @map("discord_role_id")
  assignedAt    DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  discordRole   DiscordRole @relation(fields: [discordRoleId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, discordRoleId])
  @@map("user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  discordRoleId String      @map("discord_role_id")
  permissionId  Int         @map("permission_id")
  discordRole   DiscordRole @relation(fields: [discordRoleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([discordRoleId, permissionId])
  @@map("role_permissions")
}

model Division {
  id                Int                   @id @default(autoincrement())
  name              String
  slug              String                @unique
  description       String
  iconUrl           String?               @map("icon_url")
  isActive          Boolean               @default(true) @map("is_active")
  sortOrder         Int                   @default(0) @map("sort_order")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  allowedRoles      DivisionAllowedRole[]
  mercenaryProfiles MercenaryProfile[]
  subdivisions      Subdivision[]

  @@map("divisions")
}

model Subdivision {
  id                Int                      @id @default(autoincrement())
  divisionId        Int                      @map("division_id")
  name              String
  slug              String                   @unique
  description       String
  patchImagePath    String?                  @map("patch_image_path")
  isActive          Boolean                  @default(true) @map("is_active")
  sortOrder         Int                      @default(0) @map("sort_order")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  mercenaryProfiles MercenaryProfile[]
  allowedRoles      SubdivisionAllowedRole[]
  division          Division                 @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@map("subdivisions")
}

model Rank {
  id                Int                @id @default(autoincrement())
  name              String
  slug              String             @unique
  sortOrder         Int                @default(0) @map("sort_order")
  isLeadershipCore  Boolean            @default(false) @map("is_leadership_core")
  isOfficerCore     Boolean            @default(false) @map("is_officer_core")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  mercenaryProfiles MercenaryProfile[]

  @@map("ranks")
}

model DivisionAllowedRole {
  divisionId    Int         @map("division_id")
  discordRoleId String      @map("discord_role_id")
  discordRole   DiscordRole @relation(fields: [discordRoleId], references: [id], onDelete: Cascade)
  division      Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([divisionId, discordRoleId])
  @@map("division_allowed_roles")
}

model SubdivisionAllowedRole {
  subdivisionId Int         @map("subdivision_id")
  discordRoleId String      @map("discord_role_id")
  discordRole   DiscordRole @relation(fields: [discordRoleId], references: [id], onDelete: Cascade)
  subdivision   Subdivision @relation(fields: [subdivisionId], references: [id], onDelete: Cascade)

  @@id([subdivisionId, discordRoleId])
  @@map("subdivision_allowed_roles")
}

model MercenaryProfile {
  id              String                            @id @default(uuid()) @db.Uuid
  userId          String                            @map("user_id") @db.Uuid
  characterName   String                            @map("character_name")
  rankId          Int?                              @map("rank_id")
  divisionId      Int                               @map("division_id")
  subdivisionId   Int?                              @map("subdivision_id")
  portraitUrl     String?                           @map("portrait_url")
  bio             String
  status          String                            @default("PENDING")
  isPublic        Boolean                           @default(true) @map("is_public")
  lastSubmittedAt DateTime?                         @map("last_submitted_at") @db.Timestamptz(6)
  approvedAt      DateTime?                         @map("approved_at") @db.Timestamptz(6)
  approvedBy      String?                           @map("approved_by") @db.Uuid
  rejectedAt      DateTime?                         @map("rejected_at") @db.Timestamptz(6)
  rejectedBy      String?                           @map("rejected_by") @db.Uuid
  rejectionReason String?                           @map("rejection_reason")
  createdAt       DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  call_sign       String?
  approvalHistory MercenaryProfileApprovalHistory[]
  approver        User?                             @relation("ApprovedBy", fields: [approvedBy], references: [id])
  division        Division                          @relation(fields: [divisionId], references: [id])
  rank            Rank?                             @relation(fields: [rankId], references: [id])
  rejecter        User?                             @relation("RejectedBy", fields: [rejectedBy], references: [id])
  subdivision     Subdivision?                      @relation(fields: [subdivisionId], references: [id])
  user            User                              @relation("UserProfiles", fields: [userId], references: [id], onDelete: Cascade)

  @@map("mercenary_profiles")
}

model MercenaryProfileApprovalHistory {
  id        Int              @id @default(autoincrement())
  profileId String           @map("profile_id") @db.Uuid
  action    ProfileAction
  actorId   String           @map("actor_id") @db.Uuid
  reason    String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     User             @relation(fields: [actorId], references: [id])
  profile   MercenaryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("mercenary_profile_approval_history")
}

model MarketplaceCategory {
  id          Int                   @id @default(autoincrement())
  name        String
  slug        String                @unique
  description String?
  parentId    Int?                  @map("parent_id")
  isActive    Boolean               @default(true) @map("is_active")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent      MarketplaceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    MarketplaceCategory[] @relation("CategoryHierarchy")
  listings    MarketplaceListings[]

  @@map("marketplace_categories")
}

model MarketplaceListings {
  id               String                       @id @default(uuid()) @db.Uuid
  sellerUserId     String                       @map("seller_user_id") @db.Uuid
  title            String
  description      String
  categoryId       Int                          @map("category_id")
  price            Decimal                      @db.Decimal(12, 2)
  currency         String
  quantity         Int                          @default(1)
  condition        String?
  status           ListingStatus                @default(DRAFT)
  discordThreadId  String?                      @map("discord_thread_id")
  discordChannelId String?                      @map("discord_channel_id")
  expiresAt        DateTime?                    @map("expires_at") @db.Timestamptz(6)
  metadata         Json?
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?                    @map("deleted_at") @db.Timestamptz(6)
  archived_at      DateTime?                    @db.Timestamptz(6)
  external_data    Json?
  external_id      String?
  external_source  String?
  location         String?
  message_count    Int                          @default(0)
  published_at     DateTime?                    @db.Timestamptz(6)
  view_count       Int                          @default(0)
  visibility       ListingVisibility            @default(PUBLIC)
  audits           MarketplaceListingAuditLog[]
  images           MarketplaceListingImage[]
  category         MarketplaceCategory          @relation(fields: [categoryId], references: [id])
  seller           User                         @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)

  @@map("marketplace_listings")
}

model MarketplaceListingImage {
  id        Int                 @id @default(autoincrement())
  listingId String              @map("listing_id") @db.Uuid
  imageUrl  String              @map("image_url")
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  listing   MarketplaceListings @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, sortOrder])
  @@map("marketplace_listing_images")
}

model MarketplaceUserStatus {
  userId      String    @id @map("user_id") @db.Uuid
  isSuspended Boolean   @default(false) @map("is_suspended")
  reason      String?
  suspendedBy String?   @map("suspended_by") @db.Uuid
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  suspender   User?     @relation("SuspendedBy", fields: [suspendedBy], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("marketplace_user_status")
}

model MarketplaceListingAuditLog {
  id        Int                 @id @default(autoincrement())
  listingId String              @map("listing_id") @db.Uuid
  actorId   String?             @map("actor_id") @db.Uuid
  action    String
  oldValues Json?               @map("old_values")
  newValues Json?               @map("new_values")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     User?               @relation(fields: [actorId], references: [id])
  listing   MarketplaceListings @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("marketplace_listing_audit_log")
}

model MarketplaceGuest {
  id Int @id @default(autoincrement())

  discordUserId String  @map("discord_user_id")
  discordTag    String? @map("discord_tag")
  guildId       String  @map("guild_id")

  joinedAt  DateTime @map("joined_at") @db.Timestamptz(6)
