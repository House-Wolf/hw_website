{
  "name": "house-wolf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm:dev:next\" \"pnpm:dev:bot\"",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:bot": "node ./bot/index.js",
    "dev:bot": "node ./bot/index.js",
    "lint": "eslint",
    "test:bot": "node --test scripts/test-bot-http-security.mjs scripts/test-bot-deployment.mjs scripts/test-personnel.mjs scripts/test-rsi-membership-sync.mjs scripts/test-discord-activity.mjs scripts/test-marketplace-guests.mjs scripts/test-onboarding.mjs scripts/test-onboarding-join.mjs scripts/test-marketplace-messaging.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/prisma-env.mjs migrate deploy",
    "db:status": "node scripts/prisma-env.mjs migrate status",
    "db:verify:personnel": "node scripts/verify-personnel-migration.mjs",
    "bot:configure-commands": "node scripts/configure-personnel-commands.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^1.6.1",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.43.0",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.554.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "vercel": "^50.41.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.5.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.32",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.2"
    }
  }
}
