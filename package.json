{
  "name": "house-wolf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm:dev:next\" \"pnpm:dev:bot\"",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:bot": "node ./bot/index.js",
    "dev:bot": "node ./bot/index.js",
    "lint": "eslint",
    "test:bot": "node --test scripts/test-bot-http-security.mjs scripts/test-bot-deployment.mjs scripts/test-personnel.mjs scripts/test-rsi-membership-sync.mjs scripts/test-discord-activity.mjs scripts/test-marketplace-guests.mjs scripts/test-onboarding.mjs scripts/test-onboarding-join.mjs scripts/test-marketplace-messaging.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/prisma-env.mjs migrate deploy",
    "db:status": "node scripts/prisma-env.mjs migrate status",
    "db:verify:personnel": "node scripts/verify-personnel-migration.mjs",
    "bot:configure-commands": "node scripts/configure-personnel-commands.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --test scripts/test-*.mjs",
    "typecheck": "tsc --noEmit",
    "test:command": "node --test scripts/test-command-foundation.mjs scripts/test-fleet-normalization.mjs scripts/test-discord-formatting.mjs scripts/test-native-events.mjs scripts/test-command-http.mjs scripts/test-command-cover.mjs",
    "test:command:db": "node --test scripts/integration-command-settings.mjs scripts/integration-native-events.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.27.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.554.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.2"
    }
  }
}
